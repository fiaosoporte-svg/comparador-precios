# Copia este archivo como .env (no lo subas a git)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Supabase > Project Settings > API > service_role (secreta)
ADMIN_TOKEN=cambia-esto-por-algo-largo      # protege los endpoints /admin
API_KEY_APP=otra-clave-para-la-app-flutter  # la app la manda en el header x-api-key
TAREAS_PROGRAMADAS=true                     # actualizaciones automáticas dentro del servidor
PORT=3000
# ARA_OCR=true    # leer el folleto de Ara con OCR para comparar sus precios (~600 MB: no cabe en Render gratis)
# CORS_ORIGENES=https://mi-app.web.app,http://localhost:8080   # versión web de la app; vacío = cualquier origen
